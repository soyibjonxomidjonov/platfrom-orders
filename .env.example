# ====== App ======
APP_NAME="Yoshlar Jobs"
NODE_ENV=development

# ====== Database (Prisma / PostgreSQL) ======
DATABASE_URL="postgresql://app:app@localhost:5433/yoshlar_jobs?schema=public"

# ====== Auth.js (NextAuth v5) ======
# `npx auth secret` bilan yangi qiymat generatsiya qiling
AUTH_SECRET="change-me"
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# ====== Groq (AI yordamchi) ======
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_FALLBACK_MODEL="qwen/qwen3.8-27b"

# ====== Admin ======
ADMIN_EMAILS="admin@example.com"

# Taklif yuborish uchun login majburiy (musobaqa rejimi uchun "false")
REQUIRE_LOGIN_FOR_PROPOSALS="true"

# ====== Email (SMTP) — faqat serverda ======
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASSWORD="gmail-app-password"
SMTP_FROM="YoshlarMakon <you@gmail.com>"
